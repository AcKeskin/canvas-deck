{
	"name": "canvas-deck",
	"version": "0.1.0",
	"private": true,
	"description": "Obsidian plugin for slide decks where each slide is an infinite canvas.",
	"author": "Ali Can Keskin (https://github.com/AcKeskin)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AcKeskin/canvas-deck.git"
	},
	"homepage": "https://github.com/AcKeskin/canvas-deck#readme",
	"bugs": {
		"url": "https://github.com/AcKeskin/canvas-deck/issues"
	},
	"keywords": ["obsidian", "obsidian-plugin", "excalidraw", "slides", "presentation"],
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"harness": "vite"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.28.2",
		"obsidian": "^1.14.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@excalidraw/excalidraw": "^0.18.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"overrides": {
		"@excalidraw/excalidraw": {
			"nanoid": "3.3.20",
			"sass": "1.105.1"
		},
		"@excalidraw/mermaid-to-excalidraw": {
			"nanoid": "5.1.16"
		},
		"lodash-es": "4.18.1",
		"katex": "0.19.0"
	}
}
